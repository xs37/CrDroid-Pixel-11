# Types the vendor contexts reference. Attributes are taken from the
# typeattributeset statements in stock's compiled vendor_sepolicy.cil rather than
# guessed from the naming, since a wrong attribute fails in ways that are hard to
# see: the label resolves and the access silently does not.

# Vendor attributes stock declares in its own policy. Declared here, in the same file
# and above first use, so the ordering holds however the build concatenates .te files.
attribute pixel_battery_service_type;
attribute pixel_bluetooth_service_type;
attribute pixel_display_hal_service_type;
attribute vendor_persist_type;

